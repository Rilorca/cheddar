post_install() {
	cat <<'EOF'
==> Cheddar is installed.
==>
==> 1. Make sure ratbagd is running (it talks to the mouse):
==>       sudo systemctl enable --now ratbagd
==>
==> 2. For automatic profile switching while Cheddar's window is closed,
==>    enable the background service for your user:
==>       systemctl --user enable --now cheddar-autopilot
==>
==> Then launch "Cheddar" from your application menu.
EOF
}

post_upgrade() {
	post_install
}
