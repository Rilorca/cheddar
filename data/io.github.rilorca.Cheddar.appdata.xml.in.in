<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.rilorca.Cheddar</id>
  <developer id="io.github.rilorca">
    <name>Rilorca</name>
  </developer>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <content_rating type="oars-1.1" />
  <name translatable="no">Cheddar</name>
  <summary>Automatic per-game profile switching for gaming mice</summary>
  <description>
    <p>
      Cheddar configures gaming mice on Linux and switches the mouse's profile
      automatically depending on which game is running — the way Logitech
      G HUB does on Windows. Set the mouse up the way you like it for each
      game, map games to those profiles, and Cheddar switches automatically
      when you launch or alt-tab into a game.
    </p>
    <p>
      It detects native Linux games as well as Windows games run through
      Steam/Proton, Lutris and Heroic, and stores unlimited named profiles on
      your PC even though the mouse only has a few onboard slots. It keeps the
      full configuration ability of Piper, which it is based on: resolution
      (DPI), profiles, LED colors and button behaviors.
    </p>
    <p>
      Cheddar is a front end to libratbag's ratbagd, which must be installed
      and running for the mouse to be detected.
    </p>
  </description>

  <screenshots>
    <screenshot type="default">
      <caption>Automatic per-game profile switching with Cheddar AutoPilot</caption>
      <image type="source">https://raw.githubusercontent.com/Rilorca/cheddar/main/data/screenshots/autopilot.png</image>
    </screenshot>
    <screenshot>
      <caption>Configuring mouse buttons, macros, and bindings</caption>
      <image type="source">https://raw.githubusercontent.com/Rilorca/cheddar/main/data/screenshots/buttons.png</image>
    </screenshot>
    <screenshot>
      <caption>Adding game profile rules with automatic installed game detection</caption>
      <image type="source">https://raw.githubusercontent.com/Rilorca/cheddar/main/data/screenshots/rule-editor.png</image>
    </screenshot>
  </screenshots>

  <launchable type="desktop-id">io.github.rilorca.Cheddar.desktop</launchable>

  <url type="homepage">https://github.com/Rilorca/cheddar</url>
  <url type="bugtracker">https://github.com/Rilorca/cheddar/issues</url>
  <url type="vcs-browser">https://github.com/Rilorca/cheddar</url>

  <translation type="gettext">cheddar</translation>

  <branding>
    <color type="primary" scheme_preference="dark">#2d3238</color>
    <color type="primary" scheme_preference="light">#e18e11</color>
  </branding>

  <provides>
    <binary>cheddar</binary>
  </provides>

  <releases>
    <release version="@version@" date="@version_date@">
      <description>
        <p>Initial release of Cheddar with AutoPilot per-game profile switching for Linux gaming mice.</p>
      </description>
    </release>
  </releases>
</component>
