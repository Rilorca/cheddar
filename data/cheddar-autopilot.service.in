# systemd user unit for the Cheddar AutoPilot daemon.
# Enable with:  systemctl --user enable --now cheddar-autopilot
[Unit]
Description=Cheddar AutoPilot — per-game mouse profile switching
After=graphical-session.target

[Service]
Type=simple
ExecStart=@bindir@/cheddar-autopilot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
